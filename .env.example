# --- Formulaire de contact (Resend) ---
# Le code accepte RESEND_API_KEY ou RESEND_API_CarditKEY (nom actuellement utilisé sur Vercel).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# --- Base de données Neon ---
# Ajoutée automatiquement par l'intégration Neon de Vercel (DATABASE_URL ou POSTGRES_URL).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Stockage d'images Vercel Blob ---
# Créé automatiquement quand vous connectez un Blob store au projet.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# --- Administration (à définir vous-même, jamais dans le code) ---
# Mot de passe de l'espace admin (page /admin, aucun lien public).
ADMIN_PASSWORD=choisissez-un-mot-de-passe-long
# Clé de signature de la session (chaîne aléatoire de 32+ caractères).
ADMIN_SECRET=une-longue-chaine-aleatoire
